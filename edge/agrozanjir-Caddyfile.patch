--- a/Caddyfile
+++ b/Caddyfile
@@ -62,2 +62,36 @@
 # YouthCapital has a literal hostname; the edge DOMAIN still belongs to AgroZanjir.
 import /etc/caddy/youthcapital/site.caddy
+
+# Rendered to runtime/edge-site.caddy by the infra controller.
+# Merge this site into the EXISTING edge Caddy source and installed Caddyfile.
+# Never replace its global block or other sites. No extra public listener.
+tijoratmarkazi.uz {
+	log {
+		format filter {
+			request>uri query {
+				delete t
+				delete token
+			}
+			request>headers>Referer delete
+		}
+	}
+
+	# HTTP-01 can pass through Cloudflare; TLS-ALPN-01 cannot traverse its proxy.
+	tls {
+		issuer acme {
+			disable_tlsalpn_challenge
+		}
+	}
+	@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
+	route {
+		request_header X-TM-Client-IP {http.request.remote.host}
+		request_header @cloudflare X-TM-Client-IP {http.request.header.CF-Connecting-IP}
+		reverse_proxy tijoratmarkazi-frontend:8080 {
+			header_up X-Real-IP {http.request.header.X-TM-Client-IP}
+			header_up X-Forwarded-For {http.request.header.X-TM-Client-IP}
+			header_up X-Forwarded-Proto https
+			header_up -CF-Connecting-IP
+			header_up -X-TM-Client-IP
+		}
+	}
+}
